<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:allowBackup="true"
        android:icon="@drawable/squash_logo"
        android:label="Punkty Squash"
        android:roundIcon="@drawable/squash_logo"
        android:theme="@style/Theme.SquashScoreboard">
        <activity android:name=".PlayerStatsActivity" android:screenOrientation="landscape" />
        <activity android:name=".PlayerDetailActivity" android:screenOrientation="landscape" />
        <activity android:name=".PlayerComparisonActivity" android:screenOrientation="landscape" />
        <activity android:name=".MatchDetailActivity" android:screenOrientation="landscape" />
        <activity android:name=".ChartFullscreenActivity" android:screenOrientation="landscape" />
        <activity android:name=".HistoryActivity" android:screenOrientation="landscape" />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
