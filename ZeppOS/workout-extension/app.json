{
  "configVersion": "v3",
  "app": {
    "appId": 20002,
    "appName": "Punkty Squash Trening",
    "appType": "app",
    "extType": "workout",
    "version": { "code": 8, "name": "1.0.7" },
    "icon": "icon.png",
    "vender": "Maciek",
    "description": "Pilot wyniku Squash jako strona treningu"
  },
  "permissions": [],
  "runtime": {
    "apiVersion": { "compatible": "3.6", "target": "4.2", "minVersion": "3.6" }
